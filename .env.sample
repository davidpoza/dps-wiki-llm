POSTGRES_DB=dps_wiki
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/dps_wiki
SPRING_DATASOURCE_USERNAME=dps_wiki
SPRING_DATASOURCE_PASSWORD=dps_wiki

SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=dps_wiki
SPRING_RABBITMQ_PASSWORD=dps_wiki

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gpt-oss
LLM_API_KEY=

EMBED_BASE_URL=http://embeddings:8080
EMBED_API_KEY=
EMBED_MODEL=multilingual-e5-small
EMBED_DIMENSION=384

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# JWT auth — generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Admin user seeded on first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Web extraction microservice (browser-rendered URL → markdown)
EXTRACTOR_BASE_URL=http://web-extractor:3000
EXTRACTOR_TIMEOUT=45s
EXTRACTOR_CONCURRENCY=3
EXTRACTOR_NAV_TIMEOUT_MS=30000
EXTRACTOR_NETWORKIDLE_MS=4000

VAULT_PATH=/vault
GIT_USER_NAME=dps-wiki-llm
GIT_USER_EMAIL=dps-wiki-llm@example.local
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200
LOG_LEVEL=INFO
