# Secretos de desarrollo local (OPCIONAL).
#
# Cópialo a backend/src/main/resources/secrets.yml para fijar tus secretos.
# Ese fichero está gitignored. Sin él, el backend arranca con los valores por
# defecto de application.yml (admin / admin y sin LLM), suficiente para empezar.
app:
  jwt:
    # Secreto base64, mínimo 32 bytes decodificados (openssl rand -base64 64).
    secret: change-me
  admin:
    username: admin
    password: admin
  llm:
    # Proveedor OpenAI-compatible. Por defecto un Ollama local; para usar un
    # servicio remoto (OpenRouter, etc.) pon su base-url, model y api-key.
    base-url: http://localhost:11434/v1
    model: gpt-oss
    api-key:
  telegram:
    token:
    allowed-chat-id:
  webdav:
    # Réplica WebDAV opcional del vault. Déjalo en blanco para desactivarla.
    url:
    username:
    password:
